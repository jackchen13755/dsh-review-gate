{
  "baselineCmd": "node --test --test-reporter=tap tests/canary/",
  "mutants": [
    {
      "id": "trigger.removal-threshold",
      "file": "lib/trigger.js",
      "old": "if (totalRemoved >= removalThreshold) reasons.add(REASONS.DELETION);",
      "new": "if (totalRemoved > removalThreshold) reasons.add(REASONS.DELETION);",
      "expectRed": "@canary id=trigger.removal-threshold",
      "why": "把 >= 改成 > 会让「刚好删满阈值」这一格静默失效；判定类代码最典型的一格。"
    },
    {
      "id": "trigger.removal-threshold-overtrigger",
      "file": "lib/trigger.js",
      "old": "if (totalRemoved >= removalThreshold) reasons.add(REASONS.DELETION);",
      "new": "if (totalRemoved >= removalThreshold - 1) reasons.add(REASONS.DELETION);",
      "expectRed": "@canary id=trigger.removal-threshold",
      "why": "反方向：阈值被悄悄放宽一行（过度触发）。只钉「少判」一个方向等于只锁半扇门——审查实测发现这条反向断言当时没有任何变异体碰过。"
    },
    {
      "id": "review-expert.alias-match",
      "file": "lib/review-expert.js",
      "old": "  return normalized !== '' && ALIAS_SET.has(normalized);",
      "new": "  return normalized !== '';",
      "expectRed": "@canary id=review-expert.alias-match",
      "why": "把「必须命中别名」放宽成「任何非空专家名都算」是这条判据最可能的退化形态：门禁会把「叫 UI 设计师」当成已评审。反向断言（UI 设计师不算）必须能红。"
    },
    {
      "id": "review-expert.tool-name",
      "file": "lib/review-expert.js",
      "old": "  return REVIEW_TOOL_NAMES.some((tool) => trimmed === tool || trimmed.endsWith(`__${tool}`));",
      "new": "  return true;",
      "expectRed": "@canary id=review-expert.tool-name",
      "why": "反方向：把工具名判据整段放开，任何工具只要参数里带「代码审查工程师」都会被当成评审证据。只钉专家名一个方向等于只锁半扇门。"
    },
    {
      "id": "jury.min-seats",
      "file": "lib/jury.js",
      "old": "  if (cast < seats) {",
      "new": "  if (false) {",
      "expectRed": "@canary id=jury.min-seats",
      "why": "把「三席齐备」摘掉，两票 pass 就会被当成通过——这正是「第三票还没投」被读成「已通过」的形态。"
    },
    {
      "id": "jury.majority-threshold",
      "file": "lib/jury.js",
      "old": "  if (counts.pass >= need) {",
      "new": "  if (counts.pass > need) {",
      "expectRed": "@canary id=jury.majority-threshold",
      "why": "把多数门槛的 >= 改成 >，恰好达到门槛（2/3）时静默不通过：判定类代码最典型的一格。"
    },
    {
      "id": "jury.verdict-set",
      "file": "lib/jury.js",
      "old": "  if (typeof verdict !== 'string' || !VERDICT_SET.has(verdict)) {",
      "new": "  if (false) {",
      "expectRed": "@canary id=jury.verdict-set",
      "why": "把单票结论的集合校验整段放开，'PASS' 这类未知值会被收下并进入多数决——坏票必须整组作废。"
    }
  ]
}
